# --- Required ---
# Any OpenAI-compatible endpoint (OpenAI, DeepSeek, a local Ollama, ...)
OPENAI_API_KEY=sk-...
# OPENAI_API_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# --- Optional ---
# Public URL of this install (used in OAuth redirects and share links)
# APP_URL=http://localhost:8080
# OVID_PORT=8080

# Sign-in codes are printed to the container log unless you set a Resend key.
# RESEND_API_KEY=re_...

# Google sign-in (optional — email codes work without it)
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# Shared secret between the app and the translator container
# TRANSLATOR_SECRET=change-me
